{
  "name": "@fylar/office-sdk",
  "version": "1.0.0",
  "description": "Commercial browser SDK for viewing and editing DOCX, XLSX, and PPTX documents.",
  "license": "SEE LICENSE IN legal.txt",
  "author": "Fylar",
  "keywords": [
    "office",
    "docx",
    "xlsx",
    "pptx",
    "document",
    "editor",
    "browser",
    "webassembly",
    "sdk"
  ],
  "homepage": "https://github.com/FylarOpen/fylar-office-sdk#readme",
  "bugs": {
    "url": "https://github.com/FylarOpen/fylar-office-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FylarOpen/fylar-office-sdk.git",
    "directory": "lib"
  },
  "type": "module",
  "main": "./UI.js",
  "module": "./UI.js",
  "types": "./UI.d.ts",
  "style": "./style.css",
  "files": [
    "*.js",
    "*.d.ts",
    "*.css",
    "manifest.json",
    "legal.txt",
    "THIRD_PARTY_NOTICES",
    "README.md",
    "locale-assets/",
    "vendor/",
    "worker/"
  ],
  "exports": {
    ".": {
      "types": "./UI.d.ts",
      "import": "./UI.js",
      "default": "./UI.js"
    },
    "./UI": {
      "types": "./UI.d.ts",
      "import": "./UI.js",
      "default": "./UI.js"
    },
    "./UI.js": {
      "types": "./UI.d.ts",
      "import": "./UI.js",
      "default": "./UI.js"
    },
    "./preload": {
      "import": "./preload.js",
      "default": "./preload.js"
    },
    "./preload.js": {
      "import": "./preload.js",
      "default": "./preload.js"
    },
    "./style.css": "./style.css",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
